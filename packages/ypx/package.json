{
  "name": "ynpx",
  "version": "3.0.4",
  "description": "`npx` equivalent in yarn, with multi-package-manager support (pnpm, yarn, npm)",
  "keywords": [
    "yarn",
    "run",
    "local",
    "bin",
    "scripts",
    "script",
    "package",
    "project",
    "npx",
    "dlx",
    "npm",
    "npm exec",
    "shell",
    "npm bin",
    "cli",
    "ypx",
    "ynpx",
    "yypx",
    "yarn-tool",
    "npm run",
    "yarn run",
    "alias",
    "global",
    "pnpm",
    "package-manager",
    "temp-directory",
    "execute",
    "run-local"
  ],
  "homepage": "https://github.com/bluelovers/ws-ypx/tree/master/packages/ypx#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-ypx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-ypx.git",
    "directory": "packages/ypx"
  },
  "license": "ISC",
  "author": "",
  "main": "index.js",
  "bin": {
    "ynpx": "bin/ypx.js",
    "ypx": "bin/ypx.js",
    "yypx": "bin/ypx.js"
  },
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "coverage": "ynpx nyc pnpm run test",
    "lint": "ynpx eslint **/*.ts",
    "test": "dotenv --override -- node --run test:node",
    "test:jest": "jest --passWithNoTests",
    "test:jest:coverage": "node --run test:jest -- --coverage",
    "test:jest:snapshot": "pnpm run test:jest -u",
    "test:node": "tsx --test --test-update-snapshots **/*.node-spec.ts **/*.node-test.ts **/*.spec.ts **/*.test.ts",
    "test:snapshot": "pnpm run test -u",
    "test:tsc": "tsc --noEmit & echo typescript check done",
    "test:tsd": "ynpx tsd",
    "test:update-snapshots": "pnpm run test -u",
    "npm:publish": "npm publish",
    "preversion": "pnpm run test",
    "prepublishOnly_": "pnpm run ncu && pnpm run sort-package-json && pnpm run test",
    "prepublishOnly:all": "pnpm run ncu && yarn-tool install && pnpm run preversion && pnpm run sort-package-json & pnpm run cli:help",
    "postpublish_": "git commit -m \"chore(release): publish\" .",
    "bin:self": "ts-node bin/ypx.ts",
    "cli:help": "ts-node bin/ypx -h",
    "ncu": "yarn-tool ncu -u",
    "sort-package-json": "yarn-tool sort",
    "tsc:default": "tsc -p tsconfig.json",
    "tsc:esm": "tsc -p tsconfig.esm.json",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "@yarn-tool/detect-package-manager": "^1.0.13",
    "@yarn-tool/env-path": "^2.0.17",
    "@yarn-tool/get-pkg-bin": "^3.0.14",
    "@yarn-tool/normalize-deps-value": "^2.0.12",
    "@yarn-tool/npa-to-deps": "^3.0.11",
    "@yarn-tool/npm-package-arg-util": "^2.0.11",
    "@yarn-tool/require-resolve": "^4.0.12",
    "@yarn-tool/update-notifier": "^1.0.50",
    "@ynpx/ynpx-argv": "^1.0.19",
    "bin-exists": "^0.2.1",
    "bluebird": "^3.7.2",
    "cache-path": "^4.0.15",
    "camel-case": "^4.1.2",
    "crlf-normalize": "^1.0.26",
    "cross-spawn-extra": "^3.0.3",
    "debug-color2": "^1.3.2",
    "fs-extra": "^11.4.1",
    "lazy-aggregate-error": "^1.0.21",
    "lodash": "^4.18.1",
    "tmp": "^0.2.7",
    "ts-type": "^3.0.18",
    "tslib": ">=2",
    "upath2": "^3.1.25",
    "which": "^7.0.0",
    "yargs": "<18 >=17.7.2"
  },
  "devDependencies": {
    "@types/which": "^3.0.4"
  },
  "gitHead": "89fa13ebd308fadf02d90f7642daca4b8182c6ec"
}
